if has nix; then
    use flake
fi

shopt -s globstar

watch_file plugin/**/*.cpp
watch_file plugin/**/*.hpp
watch_file plugin/**/*.qml
watch_file plugin/**/*.vert
watch_file plugin/**/*.frag
watch_file **/CMakeLists.txt
watch_file plugin/src/Caelestia/I18n/trs/raw.pot
watch_file plugin/src/Caelestia/I18n/trs/*.po

if ! cmake --build build --target help &> /dev/null; then
    args=()

    # Automatically pick an available C++ compiler
    if has clazy; then
        args+=(-DCMAKE_CXX_COMPILER=clazy)
    elif has clang++; then
        args+=(-DCMAKE_CXX_COMPILER=clang++)
    elif has g++; then
        args+=(-DCMAKE_CXX_COMPILER=g++)
    else
        echo "❌ No C++ compiler found!"
        echo "Install clang or gcc and try again."
        exit 1
    fi

    # Use ccache when available
    if has ccache; then
        args+=(-DCMAKE_CXX_COMPILER_LAUNCHER=ccache)
    fi

    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
        -DDISTRIBUTOR=direnv \
        -DCAELESTIA_TEST_TRS=ON \
        "${args[@]}"
fi

cmake --build build

export CAELESTIA_LIB_DIR="$PWD/build/lib"
export QML2_IMPORT_PATH="$PWD/build/qml:${QML2_IMPORT_PATH:-}"